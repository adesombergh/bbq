{
  "name": "bbq-mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Don’t grill your brain. A browser UI for Claude Code grilling sessions.",
  "keywords": [
    "bun",
    "claude-code",
    "claude-code-plugin",
    "grilling",
    "mcp",
    "mcp-server"
  ],
  "homepage": "https://github.com/adesombergh/bbq#readme",
  "bugs": "https://github.com/adesombergh/bbq/issues",
  "license": "MIT",
  "author": "Aldebaran Desombergh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adesombergh/bbq.git"
  },
  "bin": {
    "bbq-mcp": "src/mcp.ts"
  },
  "workspaces": [
    "ui"
  ],
  "files": [
    "src",
    "ui/dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run src/mcp.ts",
    "demo": "bun run scripts/demo.ts",
    "dev:ui": "bun run --cwd ui dev",
    "build": "bun run --cwd ui build",
    "lint": "oxlint --type-aware --type-check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "prepare": "lefthook install || true",
    "prepublishOnly": "test -f ui/dist/index.html || { echo 'ui/dist missing: run bun run build'; exit 1; }"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.1"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.2"
}
