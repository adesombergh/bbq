{
  "name": "grill-ui",
  "version": "0.1.0",
  "description": "MCP server that gives Claude Code a browser UI for long grilling sessions",
  "type": "module",
  "private": true,
  "bin": { "grill-ui": "./src/mcp.ts" },
  "scripts": {
    "start": "bun run src/mcp.ts",
    "build": "bun run --cwd ui build",
    "dev:ui": "bun run --cwd ui dev",
    "demo": "bun run scripts/demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --cwd ui typecheck",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
