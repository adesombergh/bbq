{
  "name": "bbq",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that gives Claude Code a browser UI for long grilling sessions",
  "bin": {
    "bbq": "./src/mcp.ts"
  },
  "workspaces": [
    "ui"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run src/mcp.ts",
    "demo": "bun run scripts/demo.ts",
    "dev:ui": "bun run --cwd ui dev",
    "build": "bun run --cwd ui build",
    "lint": "oxlint --type-aware --type-check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "test": "bun test",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.11.1"
  },
  "packageManager": "bun@1.4.2"
}
